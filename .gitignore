.gradle/
container/app/build/
build/
local.properties
*.iml
.idea/

container/app/src/main/jniLibs/
# 件的说明（component-meta.json）也是构建产物 —— build-bundle-*.sh 与
# build-native-busybox.sh 的 land_piece 每次编都会重新生成一份。
# 它必须放这里（不进 jniLibs：AGP 只把 *.so 打进 APK，见
# build.gradle.kts），但同样是生成物，不该进仓。
container/app/src/main/assets/supply/meta/

release/

dist/

feed/

*.log
.DS_Store
# 我自己用的临时目录（核对上游源码、临时脚本）—— 用完即删，
# 但别让它有机会被 git add -A 带进仓里。
.tmp*/

keys/*

.secrets/
*.token
*.keystore
keystore.properties
.env
.env.*

# 件的 .so 不进 jniLibs —— 件是自描述的标准包（assets/pieces/<id>.zip），
# 启动时由 PreinstalledPieces 走 ProgramInstallPipeline 装到 opt/<件>/<版本>/。
# jniLibs 里只该有内核垫片（liblobosposix / liblobosptyprobe / librivospty）
# 与第三方库。历史残留曾在这里堆了 43 MB 的件。
container/app/src/main/jniLibs/**/*.so

# 构建与临时产物（不入仓）
.tmpwork/
.tmpw/
dist/
work/
keys/

# 文档不入工程仓 —— 工程源码与文档分开（见 ../docs/）
# 舱内只有核心源代码与工程文件；门禁脚本本身属于工程（CI 要用），
# 但它只校验、不承载文档。
*.md
!container/app/src/main/java/lobos/**/README.md

# ── 第一类：构建产物的落点。判别形式「重跑一次构建会不会重新产生它」—— 会。
#    这些每次构建都会被脚本重新写出来，留在版本控制里只会与产物分叉。
# 从 APK 里解出来的 dex（验证用落点）
.ck/
.ck2/
.dlg/
.dlg2/
# 本地下载的件与预编译物
.dl/

# ── 第二类：仓外的工具与凭据。判别形式「它承载团队能力还是个人凭据」—— 凭据。
#    tok 是个人 GitHub 凭据，绝不入仓；ciq.js / obs.js 是取数工具，与被测工程无关。
#    工具本体按 06 建议留在仓外（work/.lobos-tools），今天按这条留档。
.lobos-tools/

# ── 规范文档：装完之后系统怎么认定它。判别形式「它是描述既有代码，还是约束未来的代码」
#    —— 前者是 README（见上面那条例外），后者是规范。
#    理由：「安装与注册表规范」是跨包全局规范，它约束 container/ 下所有包的落位与启动行为；
#    而约束与被约束必须同版本，否则 C-25（结论要标它验的是哪一次构建）在这份规范上无法执行，
#    「这条规范对应的是哪一版代码」将永远答不出。
#    而它与仓内那四份包级 README 不同形：包级 README 描述「本包是什么」，这一份定的是「装完之后系统怎么认定它」。
!docs/spec/**

