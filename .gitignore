.gradle/
container/app/build/
build/
local.properties
*.iml
.idea/

container/app/src/main/jniLibs/
# 件的说明（component-meta.json）也是构建产物 —— build-piece-*.sh 与
# build-native-busybox.sh 的 land_piece 每次编都会重新生成一份。
# 它必须放这里（不进 jniLibs：AGP 只把 *.so 打进 APK，见
# build.gradle.kts），但同样是生成物，不该进仓。
container/app/src/main/assets/supply/meta/

release/

dist/

feed/

*.log
.DS_Store
# 我自己用的临时目录（核对上游源码、临时脚本）—— 用完即删，
# 但别让它有机会被 git add -A 带进仓里。
.tmp*/

keys/*

.secrets/
*.token
*.keystore
keystore.properties
.env
.env.*

# 件的 .so 不进 jniLibs —— 件是自描述的标准包（assets/pieces/<id>.zip），
# 启动时由 PreinstalledPieces 走 ProgramInstallPipeline 装到 opt/<件>/<版本>/。
# jniLibs 里只该有内核垫片（liblobosposix / liblobosptyprobe / librivospty）
# 与第三方库。历史残留曾在这里堆了 43 MB 的件。
container/app/src/main/jniLibs/**/*.so

# 构建与临时产物（不入仓）
.tmpwork/
.tmpw/
dist/
work/
keys/

# 文档默认不入工程仓 —— 流程与发布那几份在仓外的 work/docs/
*.md

# 例外：随代码才有意义的那几份必须进仓。
# 判据：被代码或 CI 引用（门禁的报错会直接指向 DECISIONS.md，
#       路径写错就成了死链），或者它们本身就是代码的真相。
!docs/architecture/DECISIONS.md
!docs/architecture/LIBRARY-PATH.md
!docs/ENGINEERING.md
!container/app/src/main/java/lobos/**/README.md

# 本地下载的产物
.dlg/
.diag/