{
  "$comment": "通用原生CLI清单：声明 nativeLibraryDir 里的 ELF 如何作为命令启动。系统代码不含产品名，新增CLI只改这份数据。binary/loader 是 nativeLib 内的 so 文件名；占位符 @nativeLib 指 nativeLibraryDir，@tmp 指 files/.tmp，@files 指 filesDir。",
  "commands": {
    "claude": {
      "binary": "libclaude-musl.so",
      "loader": "libmusl-ld.so",
      "libraryPath": "@nativeLib",
      "env": { "MUSL_ON_TERMUX": "1", "TMPDIR": "@tmp" }
    },
    "codex": {
      "binary": "libcodex-musl.so",
      "loader": "",
      "env": { "CODEX_MANAGED_PACKAGE_ROOT": "@files/usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-arm64", "CODEX_MANAGED_BY_NPM": "1", "TMPDIR": "@tmp", "HOME": "@files" }
    }
  }
}
