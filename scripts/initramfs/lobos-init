#!/bin/sh
# 那真正的那 init 进程 —— 它以 PID 1 起来并接管。
#
# 缺陷名（C-102）**那仓内没有那 init 进程**
# => 而它治**的**是「那 initramfs 起来**之后**谁**接管**」。
# => 而那**成因**：=> 而那仓内**没有**那 init **那一件**的**本体**，
# => 而那 OsInit.kt**是**那**宿主侧**那 state.json 的管理、=> 而**它不是**那 init **进程**。
# => 而那**处置**：=> 而这一件**是**那 initramfs **那一层**里**那一个** /init。
#
# 判别形式：
# - 那**真正**的**那一个** init 进程**以 PID 1 起来**、=> 而它**要**接管**。
# - 而那 OsInit.kt**不**是**那一个**（=> 而它**在**那宿主侧、=> 而它**管**的是**那 state.json**）。
#
# 它**做**什么（=> 而那**接管**那一族）：
# 一，=> 而那**挂载**那一族（=> 而那 /proc 与那 /sys 与那 /dev**要**在**那**根**底下**）。
# 二，=> 而那**设备**那一族（=> 而那 /dev 底下**要**能**看见**那些**节点**）。
# 三，=> 而那 **initramfs** 那一层**解**完**之后**、=> 而它**要**把手**交给**那**真正**的**那一个** init。
#
# 按 C-104：而那 init **这一族** **只有**一条**路**（=> 而这一支**就是**它**）。
# 按 C-135：而那**接管**那一问与那**它是不是**那 init **进程**那一问**各**答**一件**事**。

set -u

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

# 一，=> 而那**挂载**那一族。
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# 一之二，=> 而那 **rootfs** 那一层（=> 而那**系统层** **是**那**磁盘上**的**那一层**）。
# => 而那**它** **该挂在那 LOB-OS **自己**那台里面**（=> 而那 **01** 那边裁的
# 「那 rootfs 那一层**该挂在那 LOB-OS 自己那台里面**、=> 而那**它** **不该挂在那宿主**
# Android **那一台**上**、=> 而那 07 那边**试**的**是**那宿主那一台**）。
# => 而那**它** **是**那**归档**形态**（=> 而那 **erofs** **那一族**、=> 而那**内核配置** **有**它**），
# => 而那**它** **跟**那 initramfs **那一层** **是**那**两**件**事**
# （=> 而那 initramfs 那一层**是**那**内存里**的**那一层**、=> 而那 rootfs**是**那**磁盘上**的**那一层**）。
# => 而那**这一层** **在**那 /rootfs.erofs（=> 而那**它** **是**那**归档**），
# => 而那**可写层** **是**那 /workdir（=> 而那**它** **是**那 tmpfs **挂载点**）。
# => 而那 **init** **以 PID 1** 起来**、=> 而那**它** **有**那 **CAP_SYS_ADMIN**
# （=> 而那**宿主**那一台**没有**它、=> 而那**那里** **成不了**这个**挂载**）。
# 一之二，=> 而那 **rootfs** 那一层（=> 而那**系统层** **是**那**磁盘上**的**那一层**）。
# => 而那**它** **该挂在那 LOB-OS **自己**那台里面**（=> 而那 **01** 那边裁的
# 「那 rootfs 那一层**该挂在那 LOB-OS 自己那台里面**、=> 而那**它** **不该挂在那宿主**
# Android **那一台**上**、=> 而那 07 那边**试**的**是**那宿主那一台**）。
# => 而那**它** **跟**那 initramfs **那一层** **是**那**两**件**事**
# （=> 而那 initramfs 那一层**是**那**内存里**的**那一层**、=> 而那 rootfs**是**那**磁盘上**的**那一层**）。
# => 而那**这一层** **在**那 /rootfs.squashfs **与**那 /rootfs.erofs（=> 而那**它们** **是**那**两**件**事**、
# => 而那**可写层** **是**那 /workdir（=> 而那**它** **是**那 tmpfs **挂载点**）。
# => 而那 **init** **以 PID 1** 起来**、=> 而那**它** **有**那 **CAP_SYS_ADMIN**
# （=> 而那**宿主**那一台**没有**它、=> 而那**那里** **成不了**这个**挂载**）。
# => 而那**归档** **要**那**块设备**（=> 而那**它** **不**接**那文件**）：
# => 而那**处置**：=> 而那**回路设备** **先**建**出来**（=> 而那**内核**CONFIG_BLK_DEV_LOOP=y）、
# => 而那**挂载** **用**那**块设备**。
# => 而那**设备节点** **要**那 devtmpfs（=> 而那**它** **是**那 /dev/loop* **那些**节点的**来处**）。
mkdir -p /proc /sys /dev /system /workdir 2>/dev/null || true
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
MOUNTED=""
for ARCHIVE in /rootfs.squashfs /rootfs.erofs; do
  [ -f "$ARCHIVE" ] || continue
  for d in /dev/loop0 /dev/loop1 /dev/loop2 /dev/loop3 /dev/loop4 /dev/loop5 /dev/loop6 /dev/loop7; do
    [ -b "$d" ] || continue
    losetup "$d" "$ARCHIVE" 2>/dev/null || continue
    case "$ARCHIVE" in
      *.squashfs) FSTYPE=squashfs ;;
      *.erofs) FSTYPE=erofs ;;
      *) FSTYPE="" ;;
    esac
    if [ -n "$FSTYPE" ] && mount -t "$FSTYPE" "$d" /system 2>/dev/null; then
      MOUNTED="$ARCHIVE"
      break
    fi
  done
  [ -n "$MOUNTED" ] && break
done
if [ -n "$MOUNTED" ]; then
  echo "lobos-init: 系统层已挂上（$MOUNTED，/system 只读）" >&2
else
  echo "lobos-init: 系统层挂不上（=> 而那 rootfs 那一层**装错**了**）" >&2
fi
mount -t tmpfs tmpfs /workdir 2>/dev/null || true
# 二，=> 而那**设备**那一族（=> 而那 /dev/console**要**能**读**那**内核**的**输出**）。
[ -c /dev/console ] || mknod /dev/console c 5 1 2>/dev/null || true

# 三，=> 而那 **initramfs** 那一层**解**完**之后**、=> 而它**要**把手**交给**那**真正**的**那一个** init。
# 而那**真正**的**那一个** init**是**那 /init。
# => 而那 /init**不**存在**的**时候、=> 而它**要**留**一个**能**看**的**痕迹**、
# => 而它**不**能**静默**挂**着**（=> 而那 M1 判据**要**那**上电到 shell**的**计时基准**）。
if [ ! -x /init ]; then
  echo "lobos-init: /init 不在（=> 而那 initramfs 那一层**装错**了**）" >&2
  # => 而它**挂**在**那**那一个** ps**上头**、=> 而它**能**被**看**见**、
  # => 而它**不**是**那**成功**（=> 而按 C-126）。
  while : ; do sleep 3600; done
fi
# 缺陷名（C-102）**那 exec /init**是**那**自己**、=> 而而它**永远**起不来**那 shell**
# => 而它治**的**是「那 /init 那一层**以 PID 1** 起来**并**接管**」。
# => 而那**成因**：=> 而那**这一件** **就**是**那 initramfs **那一层**里**那一个** /init、
# => 而那**它** **装**在**那 /init **那个**位置**上**、=> 而那 **exec /init** **又**指向**那**自己**、
# => 而那**它** **永远**走**不到**那**下面**那**一句**、=> 而那**它** **只**能**反复**exec **那自己**。
# => 而那**症状**（=> 而本机**实跑**的**）：=> 而那 **/init: line 39: [: not found** **反复**出现、
# => 而那**它** **没有**那 **shell** 的**任何**输出**、=> 而那**它** **不是**那**成功**（=> 而按 C-126）。
# => 而那**处置**：=> 而那 **PID 1** **要**变**成**那 **shell**（=> 而那**它**们**是**那**两**件**事**）。
# => 而那 **/init** **那一个**名字**留给**这一件**（=> 而那**内核** **按**那**那个**名字**调起**它**）。
# => 而那**别**的**那一个** init**不**在**那 initramfs **那一层**里面**（=> 而那**它** **是**那**别的**一层**的**事**、=> 而按 C-104**不合并**）。
if [ -x /bin/sh ]; then
  exec /bin/sh
fi
echo "lobos-init: 那 /bin/sh 不在（=> 而那 initramfs 那一层**装错**了**）" >&2
# => 而那 busybox 那一族**没有**那 **sleep** 那个 applet、=> 而那**它** **不能**用**它**。
# => 而那**它** **改成**那 **read**（=> 而那 busybox **有**那个 applet、=> 而它**不会**去**读**那**输入**）。
while : ; do read -t 3600 _ 2>/dev/null || true; done
