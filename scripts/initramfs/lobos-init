#!/bin/sh
# 那真正的那 init 进程 —— 它以 PID 1 起来并接管。
#
# 缺陷名（C-102）**那仓内逐字没有那 init 进程**
#    => 而而它治**的**是「那 initramfs 起来**之后**谁**接管**」。
#    => 而那**成因**：=> 而那仓内逐字**没有**那 init **那一件**的**本体**，
#       => 而那 OsInit.kt 逐字**是**那**宿主侧**那 state.json 的管理、=> 而**它不是**那 init **进程**。
#    => 而那**处置**：=> 而这一件逐字**是**那 initramfs **那一层**里**那一个** /init。
#
# 判别形式：
#   - 那**真正**的**那一个** init 进程逐字**以 PID 1 起来**、=> 而而它逐字**要**接管**。
#   - 而那 OsInit.kt 逐字**不**是**那一个**（=> 而它逐字**在**那宿主侧、=> 而它逐字**管**的是**那 state.json**）。
#
# 它逐字**做**什么（=> 而那**接管**那一族）：
#   一，=> 而那**挂载**那一族（=> 而那 /proc 与那 /sys 与那 /dev 逐字**要**在**那**根**底下**）。
#   二，=> 而那**设备**那一族（=> 而那 /dev 底下逐字**要**能**看见**那些**节点**）。
#   三，=> 而那 **initramfs** 那一层逐字**解**完**之后**、=> 而而它逐字**要**把手**交给**那**真正**的**那一个** init。
#
# 按 C-104：而那 init **这一族**逐字**只有**一条**路**（=> 而这一支**就是**它**）。
# 按 C-135：而那**接管**那一问与那**它是不是**那 init **进程**那一问逐字**各**答**一件**事**。

set -u

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

#  一，=> 而那**挂载**那一族。
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

#  二，=> 而那**设备**那一族（=> 而那 /dev/console 逐字**要**能**读**那**内核**的**输出**）。
[ -c /dev/console ] || mknod /dev/console c 5 1 2>/dev/null || true

#  三，=> 而那 **initramfs** 那一层逐字**解**完**之后**、=> 而而它逐字**要**把手**交给**那**真正**的**那一个** init。
#     而那**真正**的**那一个** init 逐字**是**那 /init。
#     => 而那 /init 逐字**不**存在**的**时候、=> 而而它逐字**要**留**一个**能**看**的**痕迹**、
#        => 而而它逐字**不**能**静默**挂**着**（=> 而那 M1 判据逐字**要**那**上电到 shell**的**计时基准**）。
if [ ! -x /init ]; then
  echo "lobos-init: /init 不在（=> 而那 initramfs 那一层逐字**装错**了**）" >&2
  #  => 而而它逐字**挂**在**那**那一个** ps**上头**、=> 而而它逐字**能**被**看**见**、
  #     => 而而它逐字**不**是**那**成功**（=> 而按 C-126）。
  while : ; do sleep 3600; done
fi
exec /init
